{
  "name": "my-resume",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tw:build": "tailwindcss -i ./src/app/input.css -o ./src/app/globals.css --content \"./src/**/*.{js,ts,jsx,tsx}\"",
    "tw:watch": "tailwindcss -i ./src/app/input.css -o ./src/app/globals.css --content \"./src/**/*.{js,ts,jsx,tsx}\" --watch",
    "prebuild": "npm run tw:build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@heroicons/react": "^2.2.0",
    "autoprefixer": "^10.5.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-animated-numbers": "^1.1.1",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-toast": "^1.0.3",
    "react-type-animation": "^3.2.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.1"
  }
}
